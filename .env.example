# Mot de passe du tableau de bord (obligatoire)
ADMIN_PASSWORD=

# Adresse publique de l'application, sans / à la fin
PUBLIC_URL=http://localhost:8000

# Claude : propositions, articles, réponses (console.anthropic.com)
ANTHROPIC_API_KEY=

# YouTube : publication et sous-titres par l'API (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rempli par : python -m studio auth-youtube
GOOGLE_REFRESH_TOKEN=

# Telegram : validations depuis le téléphone (@BotFather, puis @userinfobot pour ton identifiant)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Canal public pour la pensée du jour (facultatif), par exemple @moncanal
TELEGRAM_CHANNEL_ID=

# Réglages facultatifs, valeurs par défaut indiquées
